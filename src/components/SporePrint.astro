---
// The underside of a mushroom cap, drawn as a polar waveform.
// Gills breathe on a 145 BPM kick; hue runs blacklight violet → magenta → ember.
---
<canvas id="spore" aria-hidden="true"></canvas>

<script>
  const canvas = document.getElementById('spore') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;

  const BPM = 145;
  const GILLS = 240;
  let w = 0, r = 0, dpr = 1, running = false, visible = true, raf = 0;
  let curlTarget = 0, curl = 0;

  function resize() {
    dpr = Math.min(devicePixelRatio || 1, 2);
    w = canvas.clientWidth * dpr;
    canvas.width = canvas.height = w;
    r = w / 2;
    if (!running) draw(still ? 12 : performance.now() / 1000);
  }

  function draw(t: number) {
    ctx.clearRect(0, 0, w, w);
    ctx.globalCompositeOperation = 'lighter';
    ctx.lineWidth = Math.max(1, dpr * 1.1);

    const phase = (t * BPM / 60) % 1;
    const kick = still ? 0 : Math.exp(-phase * 7);
    curl += (curlTarget - curl) * 0.04;
    const spin = t * 0.035;
    const inner = r * 0.13;

    for (let i = 0; i < GILLS; i++) {
      const a = (i / GILLS) * Math.PI * 2 + spin;
      const edge =
        0.5 * Math.sin(3 * a + t * 0.31) +
        0.3 * Math.sin(7 * a - t * 0.23) +
        0.2 * Math.sin(17 * a + t * 0.53);
      const outer = r * (0.7 + 0.13 * edge + 0.045 * kick * (1 + Math.sin(5 * a)));
      const bend = 0.2 * Math.sin(t * 0.17) + curl;

      const x0 = r + Math.cos(a) * inner, y0 = r + Math.sin(a) * inner;
      const mid = (inner + outer) / 2;
      const cx = r + Math.cos(a + bend) * mid, cy = r + Math.sin(a + bend) * mid;
      const x1 = r + Math.cos(a + bend * 0.6) * outer, y1 = r + Math.sin(a + bend * 0.6) * outer;

      const hue = 285 + 95 * (0.5 + 0.5 * Math.sin(a * 2 + t * 0.12));
      const light = 52 + 14 * kick;
      ctx.strokeStyle = `hsla(${hue % 360} 95% ${light}% / ${0.42 + 0.25 * kick})`;
      ctx.beginPath();
      ctx.moveTo(x0, y0);
      ctx.quadraticCurveTo(cx, cy, x1, y1);
      ctx.stroke();

      if (i % 3 === 0) {
        ctx.fillStyle = `hsla(${hue % 360} 100% 72% / ${0.25 + 0.5 * kick})`;
        ctx.beginPath();
        ctx.arc(x1, y1, dpr * (1 + 1.6 * kick), 0, Math.PI * 2);
        ctx.fill();
      }
    }

    // stem scar
    ctx.globalCompositeOperation = 'source-over';
    ctx.fillStyle = '#140c10';
    ctx.beginPath();
    ctx.arc(r, r, inner * 0.92, 0, Math.PI * 2);
    ctx.fill();
  }

  function loop(ms: number) {
    draw(ms / 1000);
    raf = requestAnimationFrame(loop);
  }
  function sync() {
    const go = !still && visible && !document.hidden;
    if (go && !running) { running = true; raf = requestAnimationFrame(loop); }
    if (!go && running) { running = false; cancelAnimationFrame(raf); }
  }

  new ResizeObserver(resize).observe(canvas);
  new IntersectionObserver(([e]) => { visible = e.isIntersecting; sync(); }).observe(canvas);
  document.addEventListener('visibilitychange', sync);
  addEventListener('pointermove', (e) => { curlTarget = (e.clientX / innerWidth - 0.5) * 0.5; }, { passive: true });
  resize();
  sync();
</script>
